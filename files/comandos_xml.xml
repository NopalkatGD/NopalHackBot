<bot>
    <bot_comands>
        <!-- comados principales-->
        <default_comands>
            <comando descripcion="Iniciar bot" respuesta="[+] Iniciando Bot">start</comando>
        </default_comands>
        <gelbooru_comands> 
            <comando descripcion="Buscar una imagen aleatoria en Gelbooru" respuesta = "r img">glbr</comando>
            <comando descripcion="Buscar una imagen normal en Gelbooru" respuesta = "s img">glbr_s</comando>
            <comando descripcion="Buscar una imagen cuestionable en Gelbooru" respuesta = "q img">glbr_q</comando>
            <comando descripcion="Buscar una imagen +18 en Gelbooru" respuesta = "x img">glbr_x</comando>
        </gelbooru_comands>
        <message_manager>
            <comando descripcion="Eliminar mensajes" respuesta="dlt msg">dlt</comando>
        </message_manager>
        <!-- no usar-->
        <dialogs_comands>
            <comando descripcion="No usar" respuesta = "No usar">BlackWallGateway</comando>
        </dialogs_comands>
    </bot_comands>

